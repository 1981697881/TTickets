{
  "name": "ttickets",
  "version": "2.0.0",
  "private": true,
  "description": "Vue 3 + Vite based uni-app cinema mini-program",
  "scripts": {
    "routes:generate": "node scripts/generate-route-meta.mjs",
    "predev:h5": "npm run routes:generate",
    "dev:h5": "cross-env UNI_INPUT_DIR=./ uni",
    "predev:mp-weixin": "npm run routes:generate",
    "dev:mp-weixin": "cross-env UNI_INPUT_DIR=./ uni -p mp-weixin",
    "prebuild:h5": "npm run routes:generate",
    "build:h5": "cross-env UNI_INPUT_DIR=./ uni build",
    "prebuild:mp-weixin": "npm run routes:generate",
    "build:mp-weixin": "cross-env UNI_INPUT_DIR=./ uni build -p mp-weixin",
    "prebuild:app": "npm run routes:generate",
    "build:app": "cross-env UNI_INPUT_DIR=./ uni build -p app",
    "check:vue3": "node scripts/check-vue3-compat.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "typecheck": "vue-tsc --noEmit",
    "assets:cdn-list": "node scripts/list-cdn-assets.mjs",
    "verify:mp": "npm run check:vue3 && npm run build:mp-weixin && npm run check:release",
    "verify": "npm run check:vue3 && npm run build:h5 && npm run build:mp-weixin && npm run check:release"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5000720260410001",
    "@dcloudio/uni-app-plus": "3.0.0-5000720260410001",
    "@dcloudio/uni-components": "3.0.0-5000720260410001",
    "@dcloudio/uni-h5": "3.0.0-5000720260410001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5000720260410001",
    "clipboard": "^2.0.11",
    "dayjs": "^1.11.13",
    "jweixin-module": "^1.6.0",
    "miniapp-color-thief": "^1.0.5",
    "uview-plus": "^3.8.82",
    "vue": "^3.4.21",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5000720260410001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5000720260410001",
    "@types/node": "26.2.0",
    "@vue/runtime-core": "^3.4.21",
    "cross-env": "^7.0.3",
    "jsonc-parser": "^3.3.1",
    "sass": "1.77.8",
    "typescript": "5.6.3",
    "vite": "5.2.8",
    "vue-tsc": "2.1.10"
  }
}
